# Agent Relay — Grafana dashboard (provisioned).
# Displays core request metrics by endpoint, error rates, and log/trace volume.
{
  "__inputs": [],
  "__requires": [],
  "title": "Agent Relay",
  "uid": "agent-relay",
  "panels": [
    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(agent_relay_http_server_duration_count[1m])",
          "legendFormat": "{{http_method}} {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "rate(agent_relay_http_server_duration_count{http_status_code=~\"5..\"}[1m])",
          "legendFormat": "5xx {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(agent_relay_http_server_duration_bucket[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Recent Logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "{service_name=\"agent-relay\"}",
          "legendFormat": ""
        }
      ],
      "datasource": "Loki"
    },
    {
      "title": "Recent Traces (Tempo)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "query": "{service.name=\"agent-relay\"}",
          "queryType": "serviceMap",
          "datasource": "Tempo"
        }
      ],
      "datasource": "Tempo"
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
