{
  "__inputs": [],
  "__requires": [],
  "title": "Order Tracker",
  "uid": "order-tracker",
  "panels": [
    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(order_tracker_http_server_duration_milliseconds_count[1m])",
          "legendFormat": "{{http_method}} {{http_target}}"
        },
        {
          "expr": "order_tracker_http_server_active_requests",
          "legendFormat": "active requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(order_tracker_http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors"
        },
        {
          "expr": "sum(rate(order_tracker_http_server_duration_milliseconds_count{http_status_code=~\"4..\"}[1m]))",
          "legendFormat": "4xx errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(order_tracker_http_server_duration_milliseconds_bucket[5m]))",
          "legendFormat": "{{http_target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "title": "HTTP Status Codes by Endpoint",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, order_tracker_http_server_duration_milliseconds_count)",
          "format": "table",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "title": "Recent Logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "{service_name=\"order-tracker\"} |= ``",
          "legendFormat": ""
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      }
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  }
}
