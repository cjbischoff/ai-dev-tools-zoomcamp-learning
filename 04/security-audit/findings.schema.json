{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityFinding",
  "description": "Schema for a single security audit finding, covering all three methodology layers.",
  "type": "object",
  "required": [
    "finding_id",
    "source",
    "severity",
    "location",
    "description",
    "disposition"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique identifier for the finding (e.g., SEMGREP-001, MODEL-001)."
    },
    "source": {
      "type": "string",
      "enum": ["semgrep", "model_review", "human"],
      "description": "Which layer identified this finding."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"],
      "description": "Severity level."
    },
    "location": {
      "type": "string",
      "description": "File path and line (e.g., agent-relay/main.py:147)."
    },
    "cwe": {
      "type": "string",
      "description": "CWE identifier if applicable (e.g., CWE-89 for SQL injection)."
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Description of the issue and potential impact."
    },
    "recommendation": {
      "type": "string",
      "description": "Suggested remediation."
    },
    "disposition": {
      "type": "string",
      "enum": ["accepted", "mitigated", "false_positive"],
      "description": "Human disposition after review."
    },
    "disposition_notes": {
      "type": "string",
      "description": "Rationale for the disposition."
    }
  }
}
